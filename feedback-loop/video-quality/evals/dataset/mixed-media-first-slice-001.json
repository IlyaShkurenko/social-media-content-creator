{
  "schema_version": "1.2",
  "storyboard_id": "mixed-media-first-slice-001",
  "content_language": "en-US",
  "aspect_ratio": "9:16",
  "target_duration_seconds": 15,
  "hypothesis": "Showing trip-planning stress before a real tict trip plan makes the product benefit immediately understandable.",
  "brand_pronunciations": [
    {
      "canonical": "tict",
      "spoken_alias": "tickt",
      "ipa": "tɪkt"
    }
  ],
  "scenes": [
    {
      "scene_id": "hook",
      "start_seconds": 0,
      "end_seconds": 5,
      "purpose": "hook",
      "visual_intent": {
        "setting": "a bright international airport departure hall",
        "subject_action": "a solo traveller switches between several planning tabs on a phone and visibly feels overwhelmed",
        "camera": "natural handheld push-in, authentic travel-ad cinematography",
        "screen_content_policy": "non_product_context"
      },
      "media_plan": {
        "base": {
          "kind": "stock",
          "intent": "overwhelmed solo traveller planning on phone in airport"
        },
        "overlays": []
      },
      "voiceover": "Planning a trip should not feel like another job.",
      "onscreen_text": "Too much planning?",
      "expected_evidence": [
        "traveller_visible",
        "phone_visible",
        "airport_visible",
        "planning_stress_visible"
      ]
    },
    {
      "scene_id": "product_demo",
      "start_seconds": 5,
      "end_seconds": 11,
      "purpose": "product_demo",
      "visual_intent": {
        "setting": "a deterministic tict product demonstration",
        "subject_action": "the approved trip overview screen moves into view and remains legible",
        "camera": "slow controlled push toward the exact application capture",
        "screen_content_policy": "approved_product_ui"
      },
      "media_plan": {
        "base": {
          "kind": "solid_or_graphic",
          "intent": "tict warm brand background"
        },
        "overlays": [
          {
            "kind": "product_capture",
            "asset_id": "screens/Plan_Overview_Screen.png",
            "placement": "centered_phone"
          }
        ]
      },
      "voiceover": "tict turns every booking, place, and next step into one clear trip plan.",
      "onscreen_text": "Your whole trip. One plan.",
      "expected_evidence": [
        "approved_tict_ui_visible",
        "trip_plan_visible",
        "product_text_legible"
      ]
    },
    {
      "scene_id": "cta",
      "start_seconds": 11,
      "end_seconds": 15,
      "purpose": "cta",
      "visual_intent": {
        "setting": "a deterministic tict brand end card",
        "subject_action": "the approved mascot and logo appear beside one call to action",
        "camera": "static end card with a subtle local push-in",
        "screen_content_policy": "unconstrained"
      },
      "media_plan": {
        "base": {
          "kind": "solid_or_graphic",
          "intent": "tict warm brand background"
        },
        "overlays": [
          {
            "kind": "brand_asset",
            "asset_id": "tict-logo.png",
            "role": "logo",
            "placement": "upper_center"
          },
          {
            "kind": "brand_asset",
            "asset_id": "tict-mascot-1.png",
            "role": "hero",
            "placement": "center"
          }
        ]
      },
      "voiceover": "Plan less. Travel more with tict.",
      "onscreen_text": "Plan less. Travel more.",
      "call_to_action": "Create your trip",
      "layout_intent": {
        "mode": "portrait_regions",
        "elements": [
          {
            "element_id": "logo",
            "vertical_region": "top",
            "horizontal_alignment": "center",
            "scale": "medium"
          },
          {
            "element_id": "hero",
            "vertical_region": "center",
            "horizontal_alignment": "center",
            "scale": "large"
          },
          {
            "element_id": "headline",
            "vertical_region": "lower",
            "horizontal_alignment": "center",
            "scale": "medium"
          },
          {
            "element_id": "action",
            "vertical_region": "bottom",
            "horizontal_alignment": "center",
            "scale": "medium"
          }
        ]
      },
      "expected_evidence": [
        "approved_logo_visible",
        "approved_mascot_visible",
        "single_cta_visible"
      ]
    }
  ]
}
